<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Watch Next and Channels, which Apps publish in the TvProvider; posters are often on the web -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Package visibility (Android 11+): the TV apps the Launcher shows -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
            android:label="@string/app_name"
            android:theme="@style/Theme.Launcher"
            android:supportsRtl="true">
        <activity android:name=".LauncherActivity"
                android:exported="true"
                android:launchMode="singleTask"
                android:clearTaskOnLaunch="true"
                android:stateNotNeeded="true"
                android:excludeFromRecents="true"
                android:screenOrientation="landscape"
                android:configChanges="locale|layoutDirection|keyboard|keyboardHidden|navigation|uiMode|screenSize|screenLayout|smallestScreenSize|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
